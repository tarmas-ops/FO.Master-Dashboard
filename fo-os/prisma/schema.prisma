// Modelo de datos del Family Office OS para PostgreSQL.
// Hoy la app corre sobre mock data tipada (/data); este schema define el destino
// al que se migrará sin cambiar la capa de cálculo (/lib/calculos).
//
// Principio: Entidad → Participación → Activo → Flujo de Caja → Valorización → Retorno → Decisión.
// La participación económica look-through NUNCA se almacena; se calcula desde Ownership.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  CLP
  UF
  USD
}

enum EntityType {
  FAMILY_OFFICE
  HOLDING
  SPV
  OPERATING_COMPANY
  FUND
  PERSON
}

enum AssetClass {
  INMOBILIARIO
  EMPRESAS_PRIVADAS
  MERCADOS_PRIVADOS
  MERCADOS_PUBLICOS
  RENTA_FIJA
  CAJA
  OTROS
}

enum TransactionType {
  INGRESO
  EGRESO
}

enum DecisionType {
  INVEST
  HOLD
  SELL
  REFINANCE
  INCREASE
  REDUCE
  PASS
}

enum DealStage {
  ORIGINADO
  EVALUACION_INICIAL
  UNDERWRITING
  DUE_DILIGENCE
  COMITE_INVERSIONES
  NEGOCIACION
  CERRADO
  DESCARTADO
}

model FamilyOffice {
  id                      String   @id @default(cuid())
  name                    String
  baseCurrency            Currency @default(CLP)
  minimumLiquidityReserve Decimal  @db.Decimal(20, 2)
  maxPolicyLTV            Decimal  @db.Decimal(5, 4)
  rootEntity              Entity   @relation("RootEntity", fields: [rootEntityId], references: [id])
  rootEntityId            String   @unique
  persons                 Person[]
  entities                Entity[] @relation("FamilyOfficeEntities")
}

model Person {
  id             String       @id @default(cuid())
  name           String
  role           String
  familyShare    Decimal      @db.Decimal(5, 4)
  familyOffice   FamilyOffice @relation(fields: [familyOfficeId], references: [id])
  familyOfficeId String
}

model Entity {
  id             String       @id @default(cuid())
  name           String
  entityType     EntityType
  country        String
  currency       Currency
  taxId          String?
  description    String?
  familyOffice   FamilyOffice @relation("FamilyOfficeEntities", fields: [familyOfficeId], references: [id])
  familyOfficeId String
  rootOf         FamilyOffice? @relation("RootEntity")

  // Ownership recursivo: una entidad puede ser dueña y poseída.
  ownedBy        Ownership[]  @relation("OwnedEntity")
  owns           Ownership[]  @relation("OwnerEntity")

  assets         Asset[]
  loans          Loan[]
  bankAccounts   BankAccount[]
  transactions   Transaction[]
  capitalCalls   CapitalCall[]
  documents      Document[]
  creditLines    CreditLine[]
}

model Ownership {
  id                         String   @id @default(cuid())
  ownerEntity                Entity   @relation("OwnerEntity", fields: [ownerEntityId], references: [id])
  ownerEntityId              String
  ownedEntity                Entity   @relation("OwnedEntity", fields: [ownedEntityId], references: [id])
  ownedEntityId              String
  directOwnershipPercentage  Decimal  @db.Decimal(7, 6)
  votingOwnershipPercentage  Decimal  @db.Decimal(7, 6)
  economicOwnershipPercentage Decimal @db.Decimal(7, 6)
  effectiveDate              DateTime

  @@unique([ownerEntityId, ownedEntityId, effectiveDate])
}

model Asset {
  id                  String     @id @default(cuid())
  name                String
  assetClass          AssetClass
  subAssetClass       String
  sector              String
  country             String
  currency            Currency
  currentValue        Decimal    @db.Decimal(20, 2)
  acquisitionCost     Decimal    @db.Decimal(20, 2)
  acquisitionDate     DateTime
  ownerEntity         Entity     @relation(fields: [ownerEntityId], references: [id])
  ownerEntityId       String
  ownershipPercentage Decimal    @db.Decimal(7, 6)
  valuationMethod     String
  lastValuationDate   DateTime
  liquid              Boolean    @default(false)

  realEstate          RealEstateAsset?
  company             CompanyInvestment?
  privateFund         PrivateFund?
  publicSecurity      PublicSecurity?

  loans               Loan[]
  valuations          Valuation[]
  cashFlows           CashFlow[]
  transactions        Transaction[]
  documents           Document[]
  thesis              InvestmentThesis?
  assumptions         InvestmentAssumption[]
  decisions           InvestmentDecision[]
}

model RealEstateAsset {
  assetId        String  @id
  asset          Asset   @relation(fields: [assetId], references: [id])
  realEstateType String
  location       String
  city           String
  surfaceM2      Decimal @db.Decimal(12, 2)
  noi            Decimal @db.Decimal(20, 2)
  grossRent      Decimal @db.Decimal(20, 2)
  occupancy      Decimal @db.Decimal(5, 4)
  wale           Decimal @db.Decimal(5, 2)
  tenants        Tenant[]
}

model Tenant {
  id           String          @id @default(cuid())
  realEstate   RealEstateAsset @relation(fields: [assetId], references: [assetId])
  assetId      String
  name         String
  surfaceM2    Decimal         @db.Decimal(12, 2)
  monthlyRent  Decimal         @db.Decimal(20, 2)
  leaseEnd     DateTime
}

model CompanyInvestment {
  assetId      String  @id
  asset        Asset   @relation(fields: [assetId], references: [id])
  revenue      Decimal @db.Decimal(20, 2)
  ebitda       Decimal @db.Decimal(20, 2)
  netDebt      Decimal @db.Decimal(20, 2)
  dividendsLTM Decimal @db.Decimal(20, 2)
}

model PrivateFund {
  assetId     String  @id
  asset       Asset   @relation(fields: [assetId], references: [id])
  manager     String
  vintage     Int
  strategy    String
  committed   Decimal @db.Decimal(20, 2)
  called      Decimal @db.Decimal(20, 2)
  distributed Decimal @db.Decimal(20, 2)
  nav         Decimal @db.Decimal(20, 2)
  capitalCalls  CapitalCall[]
  distributions Distribution[]
}

model PublicSecurity {
  assetId       String  @id
  asset         Asset   @relation(fields: [assetId], references: [id])
  ticker        String
  issuer        String
  shares        Decimal @db.Decimal(20, 4)
  price         Decimal @db.Decimal(20, 6)
  dividendYield Decimal @db.Decimal(7, 6)
  dividendsLTM  Decimal @db.Decimal(20, 2)
}

model InvestmentPosition {
  id          String   @id @default(cuid())
  assetId     String
  entityId    String
  quantity    Decimal  @db.Decimal(20, 4)
  costBasis   Decimal  @db.Decimal(20, 2)
  openedAt    DateTime
  closedAt    DateTime?
}

model Loan {
  id                String   @id @default(cuid())
  name              String
  bank              String
  borrowerEntity    Entity   @relation(fields: [borrowerEntityId], references: [id])
  borrowerEntityId  String
  asset             Asset?   @relation(fields: [assetId], references: [id])
  assetId           String?
  balance           Decimal  @db.Decimal(20, 2)
  originalAmount    Decimal  @db.Decimal(20, 2)
  currency          Currency
  rate              Decimal  @db.Decimal(7, 6)
  rateType          String
  amortization      String
  originationDate   DateTime
  maturityDate      DateTime
  annualDebtService Decimal  @db.Decimal(20, 2)
  transactions      Transaction[]
  documents         Document[]
}

model CreditLine {
  id       String   @id @default(cuid())
  bank     String
  entity   Entity   @relation(fields: [entityId], references: [id])
  entityId String
  limit    Decimal  @db.Decimal(20, 2)
  drawn    Decimal  @db.Decimal(20, 2)
  currency Currency
}

model BankAccount {
  id          String   @id @default(cuid())
  entity      Entity   @relation(fields: [entityId], references: [id])
  entityId    String
  bank        String
  accountType String
  currency    Currency
  balance     Decimal  @db.Decimal(20, 2)
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  date        DateTime
  entity      Entity          @relation(fields: [entityId], references: [id])
  entityId    String
  asset       Asset?          @relation(fields: [assetId], references: [id])
  assetId     String?
  loan        Loan?           @relation(fields: [loanId], references: [id])
  loanId      String?
  account     BankAccount?    @relation(fields: [accountId], references: [id])
  accountId   String?
  category    String
  type        TransactionType
  amount      Decimal         @db.Decimal(20, 2)
  currency    Currency
  description String
  realized    Boolean         @default(true)

  @@index([date])
  @@index([entityId, date])
}

model Valuation {
  id      String   @id @default(cuid())
  asset   Asset    @relation(fields: [assetId], references: [id])
  assetId String
  date    DateTime
  value   Decimal  @db.Decimal(20, 2)
  method  String
  noi     Decimal? @db.Decimal(20, 2)

  @@index([assetId, date])
}

model CashFlow {
  id        String   @id @default(cuid())
  asset     Asset    @relation(fields: [assetId], references: [id])
  assetId   String
  period    DateTime
  category  String
  amount    Decimal  @db.Decimal(20, 2)
  projected Boolean  @default(false)
}

model CapitalCall {
  id       String      @id @default(cuid())
  fund     PrivateFund @relation(fields: [fundId], references: [assetId])
  fundId   String
  entity   Entity      @relation(fields: [entityId], references: [id])
  entityId String
  dueDate  DateTime
  amount   Decimal     @db.Decimal(20, 2)
  status   String
}

model Distribution {
  id     String      @id @default(cuid())
  fund   PrivateFund @relation(fields: [fundId], references: [assetId])
  fundId String
  date   DateTime
  amount Decimal     @db.Decimal(20, 2)
}

model Document {
  id         String   @id @default(cuid())
  name       String
  type       String
  entity     Entity?  @relation(fields: [entityId], references: [id])
  entityId   String?
  asset      Asset?   @relation(fields: [assetId], references: [id])
  assetId    String?
  loan       Loan?    @relation(fields: [loanId], references: [id])
  loanId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id])
  dealId     String?
  uploadedAt DateTime @default(now())
  sizeKb     Int
  storageKey String?
}

model Deal {
  id               String    @id @default(cuid())
  name             String
  assetClass       AssetClass
  assetType        String
  location         String
  country          String
  stage            DealStage
  dealValue        Decimal   @db.Decimal(20, 2)
  equityRequired   Decimal   @db.Decimal(20, 2)
  debt             Decimal   @db.Decimal(20, 2)
  expectedIRR      Decimal   @db.Decimal(7, 6)
  downsideIRR      Decimal   @db.Decimal(7, 6)
  upsideIRR        Decimal   @db.Decimal(7, 6)
  expectedMOIC     Decimal   @db.Decimal(7, 4)
  cashOnCash       Decimal   @db.Decimal(7, 6)
  capRate          Decimal?  @db.Decimal(7, 6)
  source           String
  owner            String
  closeProbability Decimal   @db.Decimal(5, 4)
  summary          String
  thesis           String
  risks            String[]
  catalysts        String[]
  score            Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  documents        Document[]
}

model InvestmentThesis {
  id                  String   @id @default(cuid())
  asset               Asset    @relation(fields: [investmentId], references: [id])
  investmentId        String   @unique
  investmentDate      DateTime
  thesis              String
  baseCaseIRR         Decimal  @db.Decimal(7, 6)
  downsideIRR         Decimal  @db.Decimal(7, 6)
  upsideIRR           Decimal  @db.Decimal(7, 6)
  targetMOIC          Decimal  @db.Decimal(7, 4)
  targetCashOnCash    Decimal  @db.Decimal(7, 6)
  entryValuation      Decimal  @db.Decimal(20, 2)
  entryCapRate        Decimal? @db.Decimal(7, 6)
  targetExitValuation Decimal  @db.Decimal(20, 2)
  targetExitCapRate   Decimal? @db.Decimal(7, 6)
  targetExitDate      DateTime
  expectedHoldPeriod  Decimal  @db.Decimal(5, 2)
  keyRisks            String[]
  keyCatalysts        String[]
  investmentMemo      String?
  reviewFrequency     String
}

model InvestmentAssumption {
  id      String  @id @default(cuid())
  asset   Asset   @relation(fields: [assetId], references: [id])
  assetId String
  kind    String  // ENTRADA | SALIDA
  name    String
  value   Decimal @db.Decimal(20, 6)
  unit    String
}

model InvestmentDecision {
  id           String       @id @default(cuid())
  asset        Asset        @relation(fields: [investmentId], references: [id])
  investmentId String
  decisionDate DateTime
  decisionType DecisionType
  approvedBy   String
  status       String
  rationale    String
  notes        String?
  reviewDate   DateTime?
}
